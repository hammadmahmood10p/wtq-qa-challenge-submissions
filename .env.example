# Local development environment.
# NOT committed. Generated 2026-09-22. Production secrets must be different.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DATABASE_URL        pooled endpoint, used by the running app.
# DIRECT_DATABASE_URL direct endpoint, used by `prisma migrate` only.
# Locally these are usually the same. In production they MUST differ --
# see R1 in docs/DELIVERY_PLAN.md.
DATABASE_URL="postgresql://user:password@host:5432/wtq?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/wtq?sslmode=require"

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
SESSION_SECRET="replace-me -- run: pnpm gen:secrets"
CNIC_PEPPER="replace-me -- run: pnpm gen:secrets"
CNIC_ENCRYPTION_KEY="replace-me -- run: pnpm gen:secrets"

# ---------------------------------------------------------------------------
# Storage  (local | s3 | azure)
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".storage"

# S3 / MinIO
# S3_BUCKET=""
# S3_REGION=""
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Azure Blob
# AZURE_STORAGE_CONNECTION_STRING=""
# AZURE_STORAGE_CONTAINER=""

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"
MAX_UPLOAD_MB="20"

# Seeded super admin (first login forces a password change)
SEED_SUPER_ADMIN_EMAIL="admin@10pearls.com"
SEED_SUPER_ADMIN_PASSWORD="choose-a-strong-one"
