# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# storage (local driver)
/.storage

# generated prisma client
/src/generated

# keep the template committed
!.env.example

# playwright
/test-results
/playwright-report
/blob-report

# demo credentials — written in plain text, never committed
/docs/DEMO_ACCOUNTS.md
# scratch audit + diagnostic scripts (Day 11)
*.local.mjs
*.local.sh

# Production deployment configuration and certificates — never committed.
production.env
deploy/certs/*
!deploy/certs/.gitkeep
