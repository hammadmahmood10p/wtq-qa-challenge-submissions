// WTQ 2026 — QA Challenge Submission Portal
// Data model v1. See docs/ARCHITECTURE_AND_PHASES.md §4 for the rationale.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 no longer accepts connection URLs here — they live in prisma.config.ts
// (CLI / migrations) and in src/lib/db.ts (runtime). See the note in prisma.config.ts
// about why the two use different connections.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  JUDGE
  PARTICIPANT
}

enum UserStatus {
  PENDING_APPROVAL // judges only, until a super admin approves
  ACTIVE
  BLOCKED
  SUBMITTED_LOCKED // participant has finally submitted; cannot log in again
  REMOVED // soft delete
}

enum Location {
  KARACHI
  LAHORE
  ISLAMABAD
}

enum AttemptState {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

/// Which half of a Challenge 1 entry an attachment belongs to.
enum Challenge1Slot {
  BUG
  TEST
}

enum ChallengeKey {
  C1
  C2
  C3
  C4
}

/// Challenges 3 and 4 are alternatives: a participant commits to one and the other
/// closes. Recorded here rather than inferred from which submission rows exist,
/// because the choice is deliberate, irreversible, and carries a bonus.
enum ChallengeTrack {
  C3
  C4
}

enum EvaluationStatus {
  ASSIGNED // auto-assigned on participant submit, not yet opened
  IN_PROGRESS // judge has opened it and may have saved partial scores
  SUBMITTED // final score submitted; locked
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid()) @db.Uuid
  role         Role
  // Always stored lowercased. Uniqueness is enforced here, across all roles.
  email        String     @unique
  fullName     String
  passwordHash String
  status       UserStatus

  // Set after an admin-issued temporary password; forces a change at next login.
  mustChangePassword Boolean @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?
  deletedAt   DateTime?

  // Populated when a super admin creates the account rather than the user signing up.
  createdById  String? @db.Uuid
  createdBy    User?   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[]  @relation("UserCreatedBy")

  participantProfile ParticipantProfile?
  judgeProfile       JudgeProfile?
  sessions           Session[]
  auditEvents        AuditLog[]          @relation("AuditActor")
  evaluations        Evaluation[]        @relation("EvaluationJudge")
  approvedJudges     JudgeProfile[]      @relation("JudgeApprovedBy")
  unlocksGranted     EvaluationUnlock[]  @relation("UnlockGrantedBy")

  @@index([role, status])
  @@index([status])
  @@map("users")
}

model ParticipantProfile {
  userId String @id @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // CNIC is sensitive PII. See docs/DELIVERY_PLAN.md §3.1:
  //   - idCardHash      : deterministic HMAC-SHA256 (peppered). Indexed; what login and
  //                       duplicate detection match against.
  //   - idCardEncrypted : AES-256-GCM ciphertext. Decrypted only for display.
  // Encrypting alone would make the column unindexable and break login-by-CNIC.
  idCardHash      String @unique
  idCardEncrypted String

  // E.164, e.g. +923001234567. Normalised on input so any typed format resolves here.
  phoneE164 String   @unique
  location  Location

  attempt Attempt?

  @@index([location])
  @@map("participant_profiles")
}

model JudgeProfile {
  userId String @id @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  approvedById String?   @db.Uuid
  approvedBy   User?     @relation("JudgeApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  @@map("judge_profiles")
}

// Server-side session record. The JWT carries only this row's id, so blocking a user
// or final submission revokes every open tab immediately.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  ip         String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// The participant's run
// ---------------------------------------------------------------------------

model Attempt {
  id            String             @id @default(uuid()) @db.Uuid
  participantId String             @unique @db.Uuid
  participant   ParticipantProfile @relation(fields: [participantId], references: [userId], onDelete: Cascade)

  // The clock. Authoritative on the server; the browser only renders a countdown
  // derived from endsAt. Every write re-checks now() < endsAt independently.
  startedAt       DateTime?
  endsAt          DateTime?
  durationMinutes Int       @default(180)

  state         AttemptState @default(NOT_STARTED)
  submittedAt   DateTime?
  autoSubmitted Boolean      @default(false)

  /// Null until the participant commits to Challenge 3 or Challenge 4. Once set it is
  /// never changed: the other challenge is closed to them from that moment.
  chosenTrack   ChallengeTrack?
  chosenTrackAt DateTime?

  /// Super-admin interventions on a sealed attempt.
  ///
  /// `reopenedAt` is set when an attempt is handed back to the participant to carry on
  /// with, and cleared when they submit again — so it reads as "this submission is
  /// currently withdrawn from judging", which is exactly what it means. The counters
  /// stay, because someone looking at an unusual result a week later should be able to
  /// see that the attempt was interrupted without digging through the audit log.
  reopenedAt  DateTime?
  reopenCount Int       @default(0)
  /// Incremented when the attempt is wiped for a fresh run. The work itself is gone.
  resetCount  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  challenge1Entries Challenge1Entry[]
  submissions       ChallengeSubmission[]
  evaluation        Evaluation?

  @@index([state])
  @@index([endsAt])
  @@map("attempts")
}

/// One finding: a bug report and the test case that covers it.
///
/// They were separate lists until the organisers asked for each test case to sit
/// beside the bug it came from — which is how a tester actually works, and makes the
/// pairing visible to a judge rather than something they have to reconstruct.
model Challenge1Entry {
  id        String  @id @default(uuid()) @db.Uuid
  attemptId String  @db.Uuid
  attempt   Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  bugTitle       String @default("")
  bugDescription String @default("")

  testTitle       String @default("")
  testDescription String @default("")

  position Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments Challenge1Attachment[]

  @@index([attemptId, position])
  @@map("challenge1_entries")
}

/// Screenshot evidence attached to one half of an entry.
///
/// Stored like any other upload — an opaque key in object storage, never a path the
/// client can construct — and served through an authorised route rather than a public
/// URL. A bug report without a screenshot is much harder to act on, so this is closer
/// to core than to a nicety.
model Challenge1Attachment {
  id      String          @id @default(uuid()) @db.Uuid
  entryId String          @db.Uuid
  entry   Challenge1Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  slot             Challenge1Slot
  fileKey          String
  originalFilename String
  contentType      String
  sizeBytes        Int
  position         Int

  createdAt DateTime @default(now())

  @@index([entryId, slot, position])
  @@map("challenge1_attachments")
}

/// One row per challenge a participant submits to.
///
/// Challenges 2, 3 and 4 differ in what they collect — a PDF, a repository link, and
/// in every case a set of written answers — but they share a lifecycle: saved
/// repeatedly during the attempt, frozen when it seals, then read by a judge. One
/// table keeps that lifecycle in one place instead of three.
///
/// Challenge 1 keeps its own table: it is a list of many items, not one submission.
model ChallengeSubmission {
  attemptId String       @db.Uuid
  challenge ChallengeKey
  attempt   Attempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  /// Uploaded report (Challenges 2 and 3). An opaque key the client never sees.
  fileKey          String?
  originalFilename String?
  sizeBytes        Int?
  contentType      String?
  uploadedAt       DateTime?

  /// Repository link (Challenge 4).
  githubUrl      String?
  /// Best-effort reachability at save time. False warns but never blocks: a GitHub
  /// outage must not cost a participant their submission.
  verifiedPublic Boolean?

  /// Written answers, keyed by question id. JSON because the questions differ per
  /// challenge and are expected to be revised between events; a column each would
  /// mean a migration every time the organisers reword one.
  answers Json @default("{}")

  savedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([attemptId, challenge])
  @@map("challenge_submissions")
}

// ---------------------------------------------------------------------------
// Judging
// ---------------------------------------------------------------------------

// One row per attempt, created by auto-assignment the moment a participant submits.
// UNIQUE on attemptId is the database backstop against two judges scoring one submission.
model Evaluation {
  id        String  @id @default(uuid()) @db.Uuid
  attemptId String  @unique @db.Uuid
  attempt   Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  judgeId String @db.Uuid
  judge   User   @relation("EvaluationJudge", fields: [judgeId], references: [id])

  assignedAt DateTime  @default(now())
  // Soft claim: refreshed while a judge has the review page open. Expires on inactivity.
  claimedAt  DateTime?

  /// Individual criterion scores. See src/lib/scoring.ts for the rubric.
  scores EvaluationScore[]

  /// Granted automatically when a participant commits to Challenge 3, and adjustable
  /// by the judge or a super admin — down to -5 where the work does not justify it.
  /// Signed, so it is an adjustment rather than a reward that can only be given.
  bonusPoints Decimal? @db.Decimal(6, 2)

  // Frozen at the moment of final submission, so a later change to the score
  // configuration can never retroactively alter a submitted result.
  totalScore  Decimal?         @db.Decimal(6, 2)
  status      EvaluationStatus @default(ASSIGNED)
  submittedAt DateTime?

  unlocks EvaluationUnlock[]

  @@index([judgeId, status])
  @@index([status])
  @@map("evaluations")
}

/// One judge's score against one rubric criterion.
///
/// A row per criterion rather than a column per criterion: the rubric is expected to
/// change between events, and adding a criterion should not require a migration. The
/// keys are defined in src/lib/scoring.ts, which is the single source of truth for
/// what exists and what each is worth.
model EvaluationScore {
  evaluationId String     @db.Uuid
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  /// e.g. "c1.bug_hunting". Validated against the rubric before it is written.
  criterion String
  score     Decimal  @db.Decimal(6, 2)
  savedAt   DateTime @default(now())

  @@id([evaluationId, criterion])
  @@map("evaluation_scores")
}

// A locked evaluation can only be reopened by a super admin, with a reason, audited.
model EvaluationUnlock {
  id           String     @id @default(uuid()) @db.Uuid
  evaluationId String     @db.Uuid
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  unlockedById String   @db.Uuid
  unlockedBy   User     @relation("UnlockGrantedBy", fields: [unlockedById], references: [id])
  reason       String
  unlockedAt   DateTime @default(now())

  @@index([evaluationId])
  @@map("evaluation_unlocks")
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

model AuditLog {
  id      String  @id @default(uuid()) @db.Uuid
  // Null for system-initiated actions such as timer auto-submit.
  actorId String? @db.Uuid
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  actorRole  Role?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

// Postgres-backed rate limiting, so no Redis server is required.
// Swappable for a Redis driver if IT provides one.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
  @@map("rate_limits")
}

// Key/value configuration, so the scoring scale is never hardcoded and can be set
// as late as the day before the event without a deployment.
// Keys: max_score_c1, max_score_c2, max_score_c2_bonus, max_score_c3,
//       attempt_duration_minutes, results_published
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}
