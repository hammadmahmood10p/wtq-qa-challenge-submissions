# Production configuration for the container stack.
#
#   cp deploy/production.env.example production.env
#   pnpm gen:secrets            # then paste the three values below
#   docker compose --env-file production.env up -d
#
# production.env is git-ignored. It is the only file that differs between one
# deployment and another — the image itself is identical everywhere.

# --- Database ---------------------------------------------------------------
# PostgreSQL runs on the VM itself, not in a container, so the app reaches it through
# the host gateway. `host.docker.internal` is mapped in docker-compose.yml.
#
# Both values are the same because there is no connection pooler: the split exists so
# migrations can bypass one, and there is nothing here to bypass.
DATABASE_URL="postgresql://wtq_app:CHANGE_ME@host.docker.internal:5432/wtq2026"
DIRECT_DATABASE_URL="postgresql://wtq_app:CHANGE_ME@host.docker.internal:5432/wtq2026"

# --- Secrets ----------------------------------------------------------------
# Generate with `pnpm gen:secrets`. These MUST differ from development.
#
# CNIC_PEPPER and CNIC_ENCRYPTION_KEY cannot be rotated once participants have
# registered: changing the pepper orphans every ID-card login, and losing the key makes
# stored ID cards unreadable. Back both up somewhere other than this VM, held by at
# least two people, before registration opens.
SESSION_SECRET="CHANGE_ME"
CNIC_PEPPER="CHANGE_ME"
CNIC_ENCRYPTION_KEY="CHANGE_ME"

# --- Application ------------------------------------------------------------
# The public origin, with https. Used when building signed file links, so a wrong
# value produces download links that point at the wrong host.
APP_URL="https://qa.example.com"

# Raising this also needs `serverActions.bodySizeLimit` in next.config.ts and
# `client_max_body_size` in deploy/nginx.conf raised to match.
MAX_UPLOAD_MB="20"

# --- Image ------------------------------------------------------------------
# Pin to a tag you built rather than `latest`, so a rollback is a one-word change.
IMAGE_TAG="latest"

# --- Notes ------------------------------------------------------------------
# Storage is set in docker-compose.yml, not here: the app writes to a named Docker
# volume that every replica mounts. Uploads are NOT in the database — back that volume
# up alongside it.
#
# SEED_SUPER_ADMIN_EMAIL / _PASSWORD are needed only for the very first deploy, to
# create the bootstrap admin. Set them, run the seed, then remove them.
